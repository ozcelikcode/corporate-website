{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!.astro",
      "!.wrangler",
      "!worker/generated",
      "!.claude",
      "!.superpowers",
      "!.code-review-graph"
    ]
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "markdown": { "formatter": { "enabled": false }, "linter": { "enabled": false } },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error", "noConsole": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["src/content/**"],
      "formatter": { "enabled": false }
    },
    {
      "includes": ["worker/**"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": { "level": "error", "options": { "allow": ["error"] } } }
        }
      }
    },
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": { "noUnusedImports": "off", "noUnusedVariables": "off" },
          "style": { "useImportType": "off" }
        }
      }
    }
  ]
}
