---
// Temporary scaffold (Tasks 1–7): the EN `home`, `about` and `contact` entries through
// SectionRenderer, inside the real layout with home's SEO data; replaced by real routes in
// Task 8. Together they cover all 7 blocks and both h1 paths (hero, and a title band from
// `pageTitle`); contact passes no `pageTitle`, so this page carries two h1s by construction.
import SectionRenderer from '../components/sections/SectionRenderer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { availableLocales, getPage } from '../lib/content.ts';

const HOME_SLUG = 'home';
const [home, about, contact, homeLocales] = await Promise.all([
  getPage('en', HOME_SLUG),
  getPage('en', 'about'),
  getPage('en', 'contact'),
  availableLocales('pages', HOME_SLUG),
]);
---
<BaseLayout
  locale="en"
  contentLocale={home.locale}
  neutralPath="/"
  title={home.data.title}
  description={home.data.description}
  ogImage={home.data.ogImage}
  availableLocales={homeLocales}
>
  <SectionRenderer sections={home.data.sections} locale="en" />
  <SectionRenderer sections={about.data.sections} locale="en" pageTitle={about.data.title} />
  <SectionRenderer sections={contact.data.sections} locale="en" />
</BaseLayout>
