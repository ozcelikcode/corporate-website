---
/**
 * Temporary, `noindex` preview of the new blocks with fixture content (deleted in Task I1).
 * SectionRenderer itself draws the title band (the page's h1) and takes the blocks in its slot,
 * each in a band of its own opening with the divider rule, as its sections are. Going through
 * SectionRenderer also keeps this page in the same CSS chunk as every other page: a page that
 * imports BaseLayout without it splits the AsciiImage styles out, inlined on every page.
 */
import { BAND, CONTAINER, DIVIDER } from '../components/sections/band-class.ts';
import { BLOCK_FIXTURES } from '../components/sections/block-fixtures.ts';
import Logos from '../components/sections/Logos.astro';
import MediaSplit from '../components/sections/MediaSplit.astro';
import SectionRenderer from '../components/sections/SectionRenderer.astro';
import Stats from '../components/sections/Stats.astro';
import Testimonial from '../components/sections/Testimonial.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { assertNever } from '../lib/assert-never.ts';
import { hrefLocalizer } from '../lib/content.ts';
import { DEFAULT_LOCALE } from '../lib/i18n.ts';

const TITLE = 'Block preview';
const DESCRIPTION = 'Fixture render of the stats, logos, media-split and testimonial blocks.';
const PREVIEW_PATH = '/blocks-preview/';
/** `[NN]` indexes count from 1. */
const FIRST_INDEX = 1;

const locale = DEFAULT_LOCALE;
const localize = await hrefLocalizer(locale);
---
<BaseLayout
  locale={locale}
  contentLocale={locale}
  neutralPath={PREVIEW_PATH}
  title={TITLE}
  description={DESCRIPTION}
  availableLocales={[]}
  noindex
>
  <SectionRenderer sections={[]} locale={locale} pageTitle={TITLE}>
    {
      BLOCK_FIXTURES.map((section, i) => {
        const common = { index: i + FIRST_INDEX, locale, localize, headingLevel: 2 } as const;
        return (
          <section class:list={[BAND, DIVIDER]}>
            <div class={CONTAINER}>
              {(() => {
                switch (section.type) {
                  case 'stats':
                    return <Stats section={section} {...common} />;
                  case 'logos':
                    return <Logos section={section} {...common} />;
                  case 'media-split':
                    return <MediaSplit section={section} {...common} />;
                  case 'testimonial':
                    return <Testimonial section={section} {...common} />;
                  default:
                    return assertNever(section);
                }
              })()}
            </div>
          </section>
        );
      })
    }
  </SectionRenderer>
</BaseLayout>
