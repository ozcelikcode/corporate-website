---
// Standalone Sveltia CMS shell: deliberately no BaseLayout (no site chrome, CSS or content).
// It lives in src/pages, not public/, because the dev server only maps `/admin/` to a route:
// a public/ file is reachable at `/admin/index.html` alone. `public/admin/config.yml` stays.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Content Manager</title>
  </head>
  <body>
    <script
      is:inline
      src="https://unpkg.com/@sveltia/cms@0.271.2/dist/sveltia-cms.js"
      integrity="sha384-4hRmbcy/P9ebtis2iErVAVn8kB4/28aak1911An7UaXd/nRNA9PZHcd2FQC3l1JE"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
