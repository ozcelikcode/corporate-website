---
/**
 * Testimonial: one pull-quote with an on-air name strap. The `[NN]` index sits in the
 * three-column gutter; the `<figure>` takes the other nine. The quote is set like the statement
 * (`text-quote`, regular weight, `quote` measure) inside the page language's own quotation marks
 * (`open-quote`/`close-quote`). The marks are decorative graphic punctuation in accent (3:1 holds
 * as a graphic at every size) with empty alt text, so they are never announced; the opening one
 * hangs. The caption is a lower third: the name above, role and organization in the strap below;
 * an optional small duotone portrait sits beside it, cropped square and decorative (`alt=""`),
 * because the name next to it carries the person.
 */
import DuotoneCover from '../ui/DuotoneCover.astro';
import GridFrame from '../ui/GridFrame.astro';
import Label from '../ui/Label.astro';
import type { BlockPreviewProps, TestimonialContent } from './block-content.ts';

type Props = BlockPreviewProps<TestimonialContent>;

/** The portrait is 4rem wide (5rem from `md`); one width plus its double for dense screens. */
const PORTRAIT_WIDTHS = [96, 192];
const PORTRAIT_SIZES = '(min-width: 48rem) 5rem, 4rem';
/** Any upload is cropped to a square, so a wide portrait never stretches the strap. */
const PORTRAIT = 'w-16 shrink-0 md:w-20 [&_img]:aspect-square [&_img]:object-cover';
/**
 * Decorative marks (`content: open-quote / ""`: empty alt text, not announced). The opening mark
 * hangs into the margin by its own width, so the words align with the name.
 */
const MARKS =
  'relative before:absolute before:-translate-x-full before:text-accent before:content-[open-quote_/_""] after:text-accent after:content-[close-quote_/_""]';
/**
 * Role and organization share the strap, split by the middle dot the page title uses (a comma
 * would hang the organization off the role).
 */
const STRAP_JOIN = ' · ';

const { section, index } = Astro.props;
const strap = `${section.role}${STRAP_JOIN}${section.organization}`;
---
<GridFrame columns={12}>
  <div class="lg:col-span-3"><Label index={index} /></div>
  <figure class="flex min-w-0 flex-col items-start gap-8 md:gap-10 lg:col-span-9">
    <blockquote class="max-w-quote text-quote font-normal text-ink wrap-break-word">
      <p class={MARKS}>{section.quote}</p>
    </blockquote>
    <figcaption class="flex items-center gap-4 md:gap-5">
      {
        section.portrait !== undefined && (
          <div class={PORTRAIT}>
            <DuotoneCover
              src={section.portrait}
              alt=""
              widths={PORTRAIT_WIDTHS}
              sizes={PORTRAIT_SIZES}
            />
          </div>
        )
      }
      <div class="flex min-w-0 flex-col items-start gap-2">
        <p class="text-lede font-semibold wrap-break-word">{section.name}</p>
        <Label text={strap} strap />
      </div>
    </figcaption>
  </figure>
</GridFrame>
