---
/**
 * Key figures set like an on-air stat bar: the indexed label as the section heading in a
 * three-column gutter, then one `surface` strip across the other nine holding 3–4 figures. Each
 * figure opens with a short accent key (a graphic, like the lower-third key), then the value
 * (large, semibold, tabular numerals so digits line up from figure to figure), its label beneath
 * and an optional muted note. Figures are set apart by spacing, never by rules. Four figures sit
 * two by two below `lg`; three stay in one column on phones and share a row from `md`.
 */
import GridFrame from '../ui/GridFrame.astro';
import Label from '../ui/Label.astro';
import type { BlockPreviewProps, StatsContent } from './block-content.ts';

type Props = BlockPreviewProps<StatsContent>;

/** A four-figure bar pairs up below `lg`; three figures share a row from `md`. */
const FOUR_UP = 4;
const COLUMNS = {
  three: 'md:grid-cols-3',
  four: 'grid-cols-2 lg:grid-cols-4',
} as const;

const { section, index, headingLevel } = Astro.props;
const HeadingTag = `h${headingLevel}` as const;
const columns = section.items.length === FOUR_UP ? COLUMNS.four : COLUMNS.three;
---
<GridFrame columns={12}>
  <HeadingTag class="lg:col-span-3">
    <Label as="span" text={section.label} index={index} />
  </HeadingTag>
  <ul
    class:list={[
      'grid grid-cols-1 gap-x-6 gap-y-10 bg-surface p-6 md:gap-x-8 md:p-8 lg:col-span-9',
      columns,
    ]}
  >
    {
      section.items.map((item) => (
        <li class="flex min-w-0 flex-col items-start gap-3">
          <span class="h-1 w-6 bg-accent" aria-hidden="true" />
          <p class="text-quote font-semibold tracking-display tabular-nums wrap-break-word">
            {item.value}
          </p>
          <Label text={item.label} />
          {item.note !== undefined && <p class="max-w-measure text-ink-muted">{item.note}</p>}
        </li>
      ))
    }
  </ul>
</GridFrame>
