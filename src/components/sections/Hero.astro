---
/**
 * Page opener: indexed label, the page's one two-tone headline (display size), lede and up to two
 * actions on the left; the ASCII render of the hero image on the right, in the title-safe frame
 * with scanlines. That frame and its marks are the hero's only lines. Stacked below `lg` (text,
 * then the image); an even 6/6 split from `lg`, so both actions keep one row at 1280; 5/7 from
 * `wide` (the page container's width), where the media also bleeds into the outer margin
 * (`--hero-bleed`, up to 10rem), so the image grows on large screens. Both columns centre on each
 * other; the band (`HERO_BAND`) fits the pair into the first screen.
 */
import AsciiImage from '../ui/AsciiImage.astro';
import Button from '../ui/Button.astro';
import GridFrame from '../ui/GridFrame.astro';
import Heading from '../ui/Heading.astro';
import Label from '../ui/Label.astro';
import { LEDE_CLASS } from '../ui/lede-class.ts';
import TitleSafe from '../ui/TitleSafe.astro';
import type { BlockProps } from './block-props.ts';

type Props = BlockProps<'hero'>;

const { section, index, headingLevel, localize } = Astro.props;
---
<GridFrame columns={12}>
  <div class="flex flex-col items-start gap-6 md:max-lg:gap-8 lg:col-span-6 lg:self-center wide:col-span-5">
    <Label text={section.label} index={index} />
    <Heading
      level={headingLevel}
      size="display"
      text={section.headline}
      accent={section.headlineAccent}
    />
    <p class={LEDE_CLASS}>{section.lede}</p>
    {
      section.actions.length > 0 && (
        <div class="flex flex-wrap gap-4">
          {section.actions.map((action, i) => (
            <Button href={localize(action.href)} intent={i === 0 ? 'primary' : 'secondary'}>
              {action.label}
            </Button>
          ))}
        </div>
      )
    }
  </div>
  <div class="min-w-0 lg:col-span-6 lg:self-center wide:col-span-7 wide:-me-(--hero-bleed)">
    <TitleSafe scanlines>
      <AsciiImage imagePath={section.imagePath} alt={section.imageAlt} />
    </TitleSafe>
  </div>
</GridFrame>
