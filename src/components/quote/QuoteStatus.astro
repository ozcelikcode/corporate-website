---
/**
 * Submission outcome panels. The Worker answers with a 303 to `/[tr/]quote/#<state>`; each state
 * is a `<section id={state} tabindex="-1">` shown only while it is the `:target` (no extra pages,
 * no JS), and fragment navigation focuses it. Each is a `surface` panel (no border) with a tally
 * heading and its body; only error panels take the `critical` lamp. The verify and send errors
 * offer the direct email address (a no-JS POST lands on `error-verify`).
 */
import { type Locale, t, type UiDictionary, type UiKey } from '../../lib/i18n.ts';
import { QUOTE_STATES, type QuoteState } from '../../lib/quote-schema.ts';
import { CONTAINER } from '../sections/band-class.ts';
import GridFrame from '../ui/GridFrame.astro';
import { LEDE_CLASS } from '../ui/lede-class.ts';
import Tally from '../ui/Tally.astro';

interface Props {
  locale: Locale;
  ui: UiDictionary;
  email: string;
}

type PanelCopy = { title: UiKey; body: UiKey; tone: 'accent' | 'critical'; offersEmail: boolean };

const PANELS = {
  sent: { title: 'quoteSentTitle', body: 'quoteSentBody', tone: 'accent', offersEmail: false },
  'error-invalid': {
    title: 'quoteErrorInvalidTitle',
    body: 'quoteErrorInvalidBody',
    tone: 'critical',
    offersEmail: false,
  },
  'error-verify': {
    title: 'quoteErrorVerifyTitle',
    body: 'quoteErrorVerifyBody',
    tone: 'critical',
    offersEmail: true,
  },
  'error-send': {
    title: 'quoteErrorSendTitle',
    body: 'quoteErrorSendBody',
    tone: 'critical',
    offersEmail: true,
  },
} as const satisfies Record<QuoteState, PanelCopy>;

const MAILTO = 'mailto:';
/**
 * Hidden unless targeted; the scroll margin keeps a targeted panel clear of the sticky header
 * (h-16) with room to spare. The panel sits in the page container, aligned with the form.
 */
const PANEL_BAND = [CONTAINER, 'scroll-mt-24 pb-16 not-target:hidden focus:outline-none md:pb-24'];
/** Aligned with the form panels (from column 4 on `lg`). */
const PANEL = 'flex flex-col items-start gap-6 bg-surface p-6 md:p-12 lg:col-span-9 lg:col-start-4';
const EMAIL_LINK =
  'text-lede text-ink underline decoration-line-strong underline-offset-4 hover:decoration-ink';

const { locale, ui: dict, email } = Astro.props;
const headingId = (state: QuoteState) => `${state}-title`;
const ui = (key: UiKey) => t(dict, locale, key);
---
{
  QUOTE_STATES.map((state) => {
    const panel = PANELS[state];
    return (
      <section
        id={state}
        tabindex="-1"
        aria-labelledby={headingId(state)}
        class:list={PANEL_BAND}
      >
        <GridFrame columns={12}>
          <div class={PANEL}>
            <h2 id={headingId(state)}>
              <Tally text={ui(panel.title)} tone={panel.tone} />
            </h2>
            <p class={LEDE_CLASS}>{ui(panel.body)}</p>
            {panel.offersEmail && (
              <a class={EMAIL_LINK} href={`${MAILTO}${email}`}>
                {email}
              </a>
            )}
          </div>
        </GridFrame>
      </section>
    );
  })
}
