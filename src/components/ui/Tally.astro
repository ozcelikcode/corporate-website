---
/**
 * Status tally: a solid square lamp plus a label. Only the lamp takes the tone colour
 * (a graphic, 3:1 suffices); the text stays ink so it keeps 4.5:1 for any valid accent.
 * `signal` sets the label as a hardware cue (mono uppercase, `label-signal`), for the PGM/PVW
 * tallies; otherwise it is a plain sans `label`.
 */
import { cva } from 'class-variance-authority';

interface Props {
  text: string;
  tone?: 'accent' | 'muted' | 'critical';
  signal?: boolean;
}

const TONE = {
  accent: 'bg-accent',
  muted: 'bg-ink-muted',
  critical: 'bg-critical',
} as const satisfies Record<NonNullable<Props['tone']>, string>;

const FACE = {
  true: 'label-signal',
  false: 'label',
} as const satisfies Record<`${NonNullable<Props['signal']>}`, string>;

const lamp = cva('size-2 shrink-0', { variants: { tone: TONE } });
const tally = cva('inline-flex items-center gap-2 text-ink', { variants: { signal: FACE } });

const { text, tone = 'accent', signal = false } = Astro.props;
---
<span class={tally({ signal })}>
  <span class={lamp({ tone })} aria-hidden="true" />
  {text}
</span>
