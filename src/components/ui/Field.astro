---
/**
 * Label, control (default slot) and optional hint. The hint id comes from `hintId(id)`; pass the
 * same value to the control's `describedBy`.
 */
import { hintId } from './hint-id.ts';

interface Props {
  id: string;
  label: string;
  hint?: string;
  optionalLabel?: string;
}

const { id, label, hint, optionalLabel } = Astro.props;
---
<div class="flex flex-col gap-2">
  <label for={id} class="flex flex-wrap items-baseline justify-between gap-x-4 label text-ink">
    {label}
    {optionalLabel !== undefined && <span class="text-ink-muted">{optionalLabel}</span>}
  </label>
  <slot />
  {hint !== undefined && <p id={hintId(id)} class="text-label text-ink-muted">{hint}</p>}
</div>
