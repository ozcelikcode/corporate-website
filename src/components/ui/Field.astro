---
/**
 * Label, control (default slot) and optional hint. The hint id is `${id}-hint`; pass it to the
 * control's `describedBy`.
 */

interface Props {
  id: string;
  label: string;
  hint?: string;
  optionalLabel?: string;
}

const { id, label, hint, optionalLabel } = Astro.props;
---
<div class="flex flex-col gap-2">
  <label for={id} class="flex flex-wrap items-baseline justify-between gap-x-4 label-mono text-ink">
    {label}
    {optionalLabel !== undefined && <span class="text-ink-muted">{optionalLabel}</span>}
  </label>
  <slot />
  {hint !== undefined && <p id={`${id}-hint`} class="font-mono text-label text-ink-muted">{hint}</p>}
</div>
