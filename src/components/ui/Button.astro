---
/**
 * Action as a hardware key. `md` carries the arrow in its own square indicator segment
 * (accent-filled on primary); `sm` sets the arrow inline. Label text stays ink in every state,
 * so it keeps 4.5:1 for any valid accent; only borders, the fill wash and the segment use accent.
 * Renders `<a>` when `href` is set; `type` then is ignored (it applies to `<button>` only).
 * The hover group is named (`group/button`) so an ancestor `.group` card never nudges the arrow.
 */
import { cva } from 'class-variance-authority';
import Glyph from './Glyph.astro';

type GlyphName = '→' | '↗';

interface Props {
  href?: string;
  /** Ignored when `href` is set. */
  type?: 'button' | 'submit';
  intent?: 'primary' | 'secondary';
  size?: 'md' | 'sm';
  glyph?: GlyphName | null;
}

/** Hrefs with this prefix leave the site and default to the ↗ glyph. */
const EXTERNAL_PREFIX = 'https://';

const INTENT = {
  primary: 'border-accent bg-accent-wash',
  secondary: 'border-line-strong hover:border-ink hover:bg-surface',
} as const satisfies Record<NonNullable<Props['intent']>, string>;

const CAPTION_SIZE = {
  md: 'px-5 py-3',
  sm: 'gap-3 px-3 py-2',
} as const satisfies Record<NonNullable<Props['size']>, string>;

const SEGMENT_INTENT = {
  primary: 'border-accent bg-accent text-canvas',
  secondary: 'border-line-strong group-hover/button:border-ink',
} as const satisfies Record<NonNullable<Props['intent']>, string>;

const button = cva(
  'group/button inline-flex min-h-11 max-w-full items-stretch border label-mono text-ink select-none',
  { variants: { intent: INTENT } },
);

const caption = cva('flex items-center', { variants: { size: CAPTION_SIZE } });

const segment = cva('flex w-11 shrink-0 items-center justify-center overflow-hidden border-s', {
  variants: { intent: SEGMENT_INTENT },
});

/** The arrow nudges along its own direction on hover and keyboard focus (transform only). */
const NUDGE = {
  '→': 'transition-transform group-hover/button:translate-x-1 group-focus-visible/button:translate-x-1',
  '↗': 'transition-transform group-hover/button:translate-x-0.5 group-hover/button:-translate-y-0.5 group-focus-visible/button:translate-x-0.5 group-focus-visible/button:-translate-y-0.5',
} as const satisfies Record<GlyphName, string>;

const { href, type = 'button', intent = 'primary', size = 'md', glyph } = Astro.props;

const resolvedGlyph: GlyphName | null =
  glyph === undefined ? (href?.startsWith(EXTERNAL_PREFIX) ? '↗' : '→') : glyph;
const Tag = href === undefined ? 'button' : 'a';
const tagAttributes = href === undefined ? { type } : { href };
---
<Tag class={button({ intent })} {...tagAttributes}>
  <span class={caption({ size })}>
    <slot />
    {size === 'sm' && resolvedGlyph !== null && <Glyph name={resolvedGlyph} class={NUDGE[resolvedGlyph]} />}
  </span>
  {
    size === 'md' && resolvedGlyph !== null && (
      <span class={segment({ intent })} aria-hidden="true">
        <Glyph name={resolvedGlyph} class={NUDGE[resolvedGlyph]} />
      </span>
    )
  }
</Tag>
