---
/**
 * An application cover as a duotone: greyscale with extra contrast (its dark ground drops to
 * black), multiplied by an accent layer, so black stays black and light lines turn accent, like
 * a dark monitor in a wall. Shared by the app-grid tiles and the application page header.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  /** `""` where the cover sits inside a link that already names it. */
  alt: string;
  widths: number[];
  sizes: string;
  loading?: 'eager' | 'lazy';
}

const FORMATS = ['avif', 'webp'];

const { src, alt, widths, sizes, loading = 'lazy' } = Astro.props;
---
<div class="relative isolate bg-canvas">
  <Picture
    src={src}
    alt={alt}
    formats={FORMATS}
    widths={widths}
    sizes={sizes}
    loading={loading}
    class="block h-auto w-full grayscale contrast-150"
  />
  <span class="absolute inset-0 bg-accent mix-blend-multiply" aria-hidden="true" />
</div>
