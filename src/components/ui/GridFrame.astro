---
/**
 * Responsive grid with a fixed column ramp (1 → md 2 → lg 3 or 4; 12 from `lg`).
 * - `spaced` (default, for content): no lines; hierarchy comes from the gaps, `surface` vs
 *   `canvas` tone and type. Children are free; tone cards set their own `bg-surface` and padding.
 * - `hairline` (budget-limited, spec §8): a cell matrix whose gap shows the `line` colour, so
 *   neighbouring cells share one line. Children are `cell`s. For 2, 3 and 4 columns the last cell
 *   spans the rest of its row (`:last-child:nth-child(…)`), so no empty track shows as a hole.
 *   Those rules are disjoint per breakpoint range (`md:max-lg:` vs `lg:`): Tailwind does not order
 *   stacked arbitrary variants by breakpoint, so they must never rely on overriding each other.
 * For 12 columns, children set `lg:col-span-*` and each row's spans must add up to 12.
 */
import { cva } from 'class-variance-authority';

interface Props {
  as?: 'div' | 'section' | 'ul';
  columns?: 1 | 2 | 3 | 4 | 12;
  variant?: 'spaced' | 'hairline';
}

const VARIANT = {
  spaced: 'grid gap-x-8 gap-y-12 lg:gap-x-12',
  hairline: 'grid-hairline',
} as const satisfies Record<NonNullable<Props['variant']>, string>;

const COLUMNS = {
  1: '',
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-2 lg:grid-cols-3',
  4: 'md:grid-cols-2 lg:grid-cols-4',
  12: 'lg:grid-cols-12',
} as const satisfies Record<NonNullable<Props['columns']>, string>;

/** Hairline only: the last cell fills its row, so the line colour never shows through a hole. */
const HAIRLINE_FILL = [
  { columns: 2, fill: ['md:[&>:last-child:nth-child(odd)]:col-span-full'] },
  {
    columns: 3,
    fill: [
      'md:max-lg:[&>:last-child:nth-child(odd)]:col-span-full',
      'lg:[&>:last-child:nth-child(3n+1)]:col-span-full',
      'lg:[&>:last-child:nth-child(3n+2)]:col-span-2',
    ],
  },
  {
    columns: 4,
    fill: [
      'md:max-lg:[&>:last-child:nth-child(odd)]:col-span-full',
      'lg:[&>:last-child:nth-child(4n+1)]:col-span-full',
      'lg:[&>:last-child:nth-child(4n+2)]:col-span-3',
      'lg:[&>:last-child:nth-child(4n+3)]:col-span-2',
    ],
  },
] as const satisfies readonly { columns: Props['columns']; fill: readonly string[] }[];

const frame = cva('', {
  variants: { variant: VARIANT, columns: COLUMNS },
  compoundVariants: HAIRLINE_FILL.map(({ columns, fill }) => ({
    variant: 'hairline' as const,
    columns,
    class: [...fill],
  })),
});

const { as: Tag = 'div', columns = 1, variant = 'spaced' } = Astro.props;
---
<Tag class={frame({ variant, columns })}><slot /></Tag>
