---
/**
 * SMPTE colour-bar micro strip: the seven 75% bars in standard order, as a thin signature mark
 * (one per page, on the footer's top rule). Bar colours are the `bars-*` tokens, the documented
 * exception to the accent-only rule. Decorative, so hidden from assistive tech.
 */
import { BAR_TONES } from './bar-tones.ts';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---
<div class:list={['flex h-1 w-42', className]} aria-hidden="true">
  {BAR_TONES.map((tone) => <span class:list={['flex-1', tone]} />)}
</div>
