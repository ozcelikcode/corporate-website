---
/**
 * Inline header nav from `lg`, no JS. A plain item is a link. A parent with a page stays a link
 * plus a separate chevron button; a parent without one is a single button (label and chevron).
 * Either button toggles the item's MegaPanel through the Popover API (`popovertarget`), so tap,
 * click and Enter open it, Escape and a click outside close it, and opening another panel closes
 * the first. The chevron turns while the panel shows.
 *
 * Only the visible controls (label and chevron, `min-h-11` tall) take the pointer: the item, its
 * full-height trigger column and the gaps between items are not hit-tested, so empty header space
 * beside or between items never starts a hover. The panel is the item's descendant, and while the
 * item is hovered a bridge fills its trigger column down to the header rule, where the panel
 * starts: a pointer moving straight down from the label never leaves the item's `:hover`. An exact
 * match carries `aria-current="page"`; the section state (`active`: this page, a page below it or
 * one of its children) draws an accent bar on the header rule (a graphic, so 3:1 is enough); a
 * hovered trigger draws the same bar in `line-strong`.
 * Known limitation: hover does not reopen a popover the keyboard left open.
 */
import type { NavItem } from '../../lib/nav-items.ts';
import Glyph from '../ui/Glyph.astro';
import MegaPanel from './MegaPanel.astro';

interface Props {
  /** Hrefs already localized, states resolved (`resolveNavItems`). */
  items: readonly NavItem[];
  navLabel: string;
  /** Appended to the item label to name its submenu button ("Applications submenu"). */
  submenuLabel: string;
}

/** Panel ids are `nav-panel-<n>`, `n` the item's position counted from 1. */
const PANEL_ID_PREFIX = 'nav-panel-';
const FIRST_POSITION = 1;

const TRIGGER =
  'nav-trigger relative flex items-center text-body font-medium text-ink after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 hover:after:bg-line-strong data-active:after:bg-accent';
/** Positioned, so each control paints (and hit-tests) above its column's bridge. */
const CONTROL = 'pointer-events-auto relative flex min-h-11 items-center whitespace-nowrap';

const { items, navLabel, submenuLabel } = Astro.props;

// `resolveNavItems` already dropped items with neither a page nor a submenu.
const entries = items.map((item, index) => {
  const panelId =
    item.children.length > 0 ? `${PANEL_ID_PREFIX}${index + FIRST_POSITION}` : undefined;
  return { ...item, panelId, buttonLabel: `${item.label} ${submenuLabel}` };
});
---
<nav aria-label={navLabel} class="hidden self-stretch lg:flex">
  <ul class="nav-list flex gap-6 xl:gap-8">
    {
      entries.map(({ label, href, current, active, children, feature, panelId, buttonLabel }) => (
        <li class="nav-item pointer-events-none flex">
          <div class={TRIGGER} data-active={active ? '' : undefined}>
            {href !== undefined && (
              <a class={CONTROL} href={href} aria-current={current ? 'page' : undefined}>
                {label}
              </a>
            )}
            {panelId !== undefined && (
              <button
                type="button"
                class:list={[CONTROL, 'gap-1', href !== undefined && 'min-w-6 ps-1']}
                popovertarget={panelId}
                aria-label={buttonLabel}
              >
                {href === undefined && label}
                <span class="chevron flex">
                  <Glyph name="⌄" size="body" />
                </span>
              </button>
            )}
          </div>
          {panelId !== undefined && <MegaPanel id={panelId} links={children} feature={feature} />}
        </li>
      ))
    }
  </ul>
</nav>

<style>
  /*
   * When a panel shows. Each item sets four state variables; its panel (visibility and a short
   * fade) and its chevron (a half turn) read them, so every state is one rule.
   *
   * Closed by default, at once: Escape, a tap or click outside, or opening another panel hide it
   * without a linger. Open at once while open as a popover (tap, click, Enter) or while focus is
   * inside the panel. With a fine pointer, an item opens after `--menu-intent-open` while the
   * pointer rests on it or its panel and closes `--menu-intent-close` after the pointer leaves;
   * hovering another item hands over on the open beat (the old panel leaves as the new one
   * arrives), so two panels never stack. Keyboard focus shown anywhere outside an item closes its
   * open popover, so a panel left open never covers the focused control (WCAG 2.4.11); taps and
   * mouse clicks do not match `:focus-visible`, so touch is unaffected. The global reduced-motion
   * rule zeroes every delay, which is safe: control, bridge and panel touch (the panel overlaps the
   * header rule), so the path from label to panel has no gap.
   */
  .nav-item {
    --menu-shown: hidden;
    --menu-fade: 0;
    --menu-turn: var(--menu-chevron-closed);
    --menu-delay: 0s;
  }

  .nav-item:has(> [data-mega-panel]:popover-open) {
    --menu-shown: visible;
    --menu-fade: 1;
    --menu-turn: var(--menu-chevron-open);
    --menu-delay: 0s;
  }

  .nav-item:has(> [data-mega-panel]:focus-within) {
    --menu-shown: visible;
    --menu-fade: 1;
    --menu-turn: var(--menu-chevron-open);
    --menu-delay: 0s;
  }

  /*
   * The bridge: the trigger column, hit-tested only once a control has started the hover. It
   * reaches a little past the column on both sides (inside the `gap-6` between items, so never
   * over a neighbour), so a diagonal move from label to panel keeps the hover even with no close
   * delay (reduced motion).
   */
  .nav-trigger::before {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline: calc(var(--spacing) * -2);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-item {
      --menu-delay: var(--menu-intent-close);
    }

    .nav-item:hover > .nav-trigger::before {
      pointer-events: auto;
    }

    /* Keyboard focus on the item's own controls (Escape returns it there): close at once. */
    .nav-item:has(:focus-visible) {
      --menu-delay: 0s;
    }

    .nav-item:hover {
      --menu-shown: visible;
      --menu-fade: 1;
      --menu-turn: var(--menu-chevron-open);
      --menu-delay: var(--menu-intent-open);
    }

    .nav-list:has(> .nav-item:hover) > .nav-item:not(:hover, :has(> [data-mega-panel]:focus-within)) {
      --menu-shown: hidden;
      --menu-fade: 0;
      --menu-turn: var(--menu-chevron-closed);
      --menu-delay: var(--menu-intent-open);
    }

    /*
     * Another panel opened as a popover: the one it replaced leaves at once. Not while the pointer
     * rests on an item whose panel is still arriving (its intent delay), or the hand-over above
     * would leave a beat with no panel at all.
     */
    .nav-list:has(> .nav-item > [data-mega-panel]:popover-open):not(
        :has(> .nav-item:hover > [data-mega-panel]:not(:popover-open))
      )
      > .nav-item:not(:hover, :has(> [data-mega-panel]:popover-open)) {
      --menu-delay: 0s;
    }
  }

  /*
   * Focus inside the panel is tested on the panel itself: Chromium does not match `:focus-within`
   * on the item while focus sits in its open (top-layer) popover. No `:hover` exemption: a pointer
   * parked over the panel band must not keep it over the focused control.
   */
  :global(:root:has(:focus-visible))
    .nav-list
    > .nav-item:not(:focus-within, :has(> [data-mega-panel]:focus-within)):has(
      > [data-mega-panel]:popover-open
    ) {
    --menu-shown: hidden;
    --menu-fade: 0;
    --menu-turn: var(--menu-chevron-closed);
    --menu-delay: 0s;
  }

  .nav-item > :global([data-mega-panel]) {
    visibility: var(--menu-shown);
    opacity: var(--menu-fade);
    transition:
      opacity var(--duration-fast) var(--ease-signal) var(--menu-delay),
      visibility var(--duration-fast) linear var(--menu-delay);
  }

  .chevron {
    transform: rotate(var(--menu-turn));
    transition: transform var(--duration-fast) var(--ease-signal) var(--menu-delay);
  }
</style>
