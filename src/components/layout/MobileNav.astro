---
/**
 * Small-screen menu on the Popover API, no JS: the button opens a full-screen sheet in the top
 * layer; Esc or the close button (placed exactly over the open button) closes it, and focus
 * returns to the button. The sheet fades on opacity only; `transition-discrete` keeps it
 * rendered while it fades out. Hidden from `lg` up, where SiteHeader shows the inline nav.
 * Row focus rings are inset (negative offset), so the scrolling sheet never clips them. The sheet's
 * top bar repeats the header's bottom rule; rows are set apart by height and tone, not lines.
 */
import type { NavItem } from '../../lib/nav-items.ts';
import Button from '../ui/Button.astro';
import Glyph from '../ui/Glyph.astro';
import Label from '../ui/Label.astro';

interface Props {
  /**
   * Resolved header items (`current`: exact page, `aria-current`; `active`: current page or its
   * section, visual). An item with children is an exclusive accordion (open when active, plus an
   * overview row for its own page); any other item is a plain row.
   */
  items: readonly NavItem[];
  quote: { label: string; href: string };
  navLabel: string;
  openLabel: string;
  closeLabel: string;
  /** Row in each submenu that links the parent page itself. */
  overviewLabel: string;
}

const MENU_ID = 'site-menu';
/** One shared name makes the accordions exclusive: opening one closes the others. */
const GROUP_NAME = 'site-menu-groups';
/** `[NN]` indexes count from 1. */
const FIRST_INDEX = 1;

const TOGGLE =
  'flex min-h-11 items-center border border-line-strong px-4 label text-ink hover:border-ink';

const { items, quote, navLabel, openLabel, closeLabel, overviewLabel } = Astro.props;

/** Row classes shared by plain rows, summaries and submenu links (inset focus ring). */
const ROW =
  'group flex items-center justify-between gap-4 px-4 text-ink hover:bg-surface focus-visible:outline-offset-[calc(var(--border-focus)*-1)] data-active:bg-surface';
const SUB_ROW =
  'flex min-h-11 flex-col justify-center gap-1 py-3 ps-8 pe-4 text-ink hover:bg-surface focus-visible:outline-offset-[calc(var(--border-focus)*-1)] aria-[current=page]:bg-surface';
---
<button type="button" class:list={[TOGGLE, 'lg:hidden']} popovertarget={MENU_ID}>
  {openLabel}
</button>

<nav
  id={MENU_ID}
  popover
  aria-label={navLabel}
  class="m-0 h-dvh max-h-none w-full max-w-none border-0 bg-canvas p-0 text-ink opacity-0 transition-[opacity,display,overlay] transition-discrete duration-(--duration-base) open:opacity-100 starting:open:opacity-0 lg:hidden"
>
  <div class="flex h-full flex-col overflow-y-auto">
    <div class="flex h-(--header-bar) shrink-0 items-center justify-end border-b border-line px-4">
      <button type="button" class={TOGGLE} popovertarget={MENU_ID} popovertargetaction="hide">
        {closeLabel}
      </button>
    </div>
    <ul class="py-4">
      {
        items.map(({ label, href, current, active, children }, index) =>
          children.length === 0 && href !== undefined ? (
            <li>
              <a
                class:list={[ROW, 'min-h-16']}
                href={href}
                aria-current={current ? 'page' : undefined}
                data-active={active ? '' : undefined}
              >
                <Label as="span" text={label} index={index + FIRST_INDEX} />
                <Glyph name="→" class="transition-transform group-hover:translate-x-1" />
              </a>
            </li>
          ) : (
            <li>
              <details name={GROUP_NAME} class="group/accordion" open={active || undefined}>
                <summary
                  class:list={[ROW, 'min-h-16 cursor-pointer list-none [&::-webkit-details-marker]:hidden']}
                  data-active={active ? '' : undefined}
                >
                  <Label as="span" text={label} index={index + FIRST_INDEX} />
                  <Glyph name="⌄" class="transition-transform group-open/accordion:rotate-180" />
                </summary>
                <ul class="pb-2">
                  {href !== undefined && (
                    <li>
                      <a
                        class={SUB_ROW}
                        href={href}
                        aria-current={current ? 'page' : undefined}
                      >
                        <span class="font-medium">{overviewLabel}</span>
                      </a>
                    </li>
                  )}
                  {children.map((child) => (
                    <li>
                      <a
                        class={SUB_ROW}
                        href={child.href}
                        aria-current={child.current ? 'page' : undefined}
                      >
                        <span lang={child.lang} class="font-medium">{child.label}</span>
                        {child.description !== undefined && (
                          <span lang={child.lang} class="text-label text-ink-muted">
                            {child.description}
                          </span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ),
        )
      }
    </ul>
    <div class="px-4 py-8">
      <Button href={quote.href}>{quote.label}</Button>
    </div>
  </div>
</nav>
