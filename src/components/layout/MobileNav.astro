---
/**
 * Small-screen menu on the Popover API, no JS: the button opens a full-screen sheet in the top
 * layer; Esc or the close button (placed exactly over the open button) closes it, and focus
 * returns to the button. The sheet fades on opacity only; `transition-discrete` keeps it
 * rendered while it fades out. Hidden from `md` up, where SiteHeader shows the inline nav.
 */
import Button from '../ui/Button.astro';
import Glyph from '../ui/Glyph.astro';
import Label from '../ui/Label.astro';

interface Props {
  links: readonly { label: string; href: string }[];
  currentPath: string;
  quote: { label: string; href: string };
  navLabel: string;
  openLabel: string;
  closeLabel: string;
}

const MENU_ID = 'site-menu';
/** `[NN]` indexes count from 1. */
const FIRST_INDEX = 1;

const TOGGLE =
  'flex min-h-11 items-center border border-line-strong px-4 label-mono text-ink hover:border-ink';

const { links, currentPath, quote, navLabel, openLabel, closeLabel } = Astro.props;
---
<button type="button" class:list={[TOGGLE, 'md:hidden']} popovertarget={MENU_ID}>
  {openLabel}
</button>

<nav
  id={MENU_ID}
  popover
  aria-label={navLabel}
  class="m-0 h-dvh max-h-none w-full max-w-none border-0 bg-canvas p-0 text-ink opacity-0 transition-[opacity,display,overlay] transition-discrete duration-(--duration-base) open:opacity-100 starting:open:opacity-0 md:hidden"
>
  <div class="flex h-full flex-col overflow-y-auto">
    <div class="flex h-16 shrink-0 items-center justify-end border-b border-line px-4">
      <button type="button" class={TOGGLE} popovertarget={MENU_ID} popovertargetaction="hide">
        {closeLabel}
      </button>
    </div>
    <ul class="divide-y divide-line border-b border-line">
      {
        links.map(({ label, href }, index) => (
          <li>
            <a
              class="group flex min-h-16 items-center justify-between gap-4 px-4 text-ink hover:bg-surface aria-[current=page]:bg-surface"
              href={href}
              aria-current={href === currentPath ? 'page' : undefined}
            >
              <Label as="span" text={label} index={index + FIRST_INDEX} />
              <Glyph name="→" class="transition-transform group-hover:translate-x-1" />
            </a>
          </li>
        ))
      }
    </ul>
    <div class="px-4 py-8">
      <Button href={quote.href}>{quote.label}</Button>
    </div>
  </div>
</nav>
