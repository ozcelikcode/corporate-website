---
/**
 * The page's closing rule (full-bleed hairline, the SMPTE bars strip laid on it at the content
 * edge), then four spaced columns (brand and legal address, indexed footer nav, contacts,
 * socials) and a rights line. No boxed cells: the columns are set apart by spacing only.
 * Contacts keep their own `mailto:` / `tel:` / `https:` hrefs; outbound links get ↗.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BarsStrip from '../ui/BarsStrip.astro';
import Glyph from '../ui/Glyph.astro';
import GridFrame from '../ui/GridFrame.astro';
import Label from '../ui/Label.astro';

type Link = { label: string; href: string };

interface Props {
  homeHref: string;
  logo: ImageMetadata;
  logoAlt: string;
  legalName: string;
  address?: string | undefined;
  links: readonly Link[];
  contacts: readonly { value: string; href: string }[];
  socials: readonly Link[];
  labels: { nav: string; contact: string; social: string; rights: string };
}

/** Hrefs with this prefix leave the site and carry the ↗ glyph. */
const EXTERNAL_PREFIX = 'https://';
/** `[NN]` indexes count from 1. */
const FIRST_INDEX = 1;
/** Stamped at build time; the site rebuilds on every content change. */
const BUILD_YEAR = new Date().getFullYear();

/** Inline-block keeps ↗ after a wrapped value's last word; padding meets the 24 CSS pixel target. */
const LINK =
  'inline-block py-1 underline decoration-line-strong underline-offset-4 hover:decoration-ink';
const GLYPH_GAP = 'ms-2';
const ROW = 'py-1.5';

const { homeHref, logo, logoAlt, legalName, address, links, contacts, socials, labels } =
  Astro.props;

/** One running `[NN]` sequence: the nav rows first, then the Contact and Follow labels. */
const contactIndex = links.length + FIRST_INDEX;
const socialIndex = contactIndex + 1;
---
<footer class="mt-24 border-t border-line">
  <div class="mx-auto max-w-page px-4 pb-8 md:px-8">
    <BarsStrip class="-mt-(--border-hairline) mb-12" />
    <GridFrame columns={4}>
      <div class="flex flex-col gap-6">
        <a href={homeHref} class="flex min-h-11 items-center self-start">
          <Image src={logo} alt={logoAlt} class="h-6 w-auto" />
        </a>
        <p class="text-ink-muted">
          <span class="block text-ink">{legalName}</span>
          {address !== undefined && <span class="block">{address}</span>}
        </p>
      </div>

      <nav aria-label={labels.nav}>
        <ul class="flex flex-col">
          {
            links.map(({ label, href }, index) => (
              <li>
                <a class="flex min-h-11 items-center hover:[&_span]:text-ink" href={href}>
                  <Label as="span" text={label} index={index + FIRST_INDEX} />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-4">
        <Label text={labels.contact} index={contactIndex} />
        <address class="not-italic">
          <ul class="flex flex-col">
            {
              contacts.map(({ value, href }) => (
                <li class={ROW}>
                  <a class={LINK} href={href}>
                    {value}
                    {href.startsWith(EXTERNAL_PREFIX) && <Glyph name="↗" class={GLYPH_GAP} />}
                  </a>
                </li>
              ))
            }
          </ul>
        </address>
      </div>

      <div class="flex flex-col gap-4">
        <Label text={labels.social} index={socialIndex} />
        <ul class="flex flex-col">
          {
            socials.map(({ label, href }) => (
              <li class={ROW}>
                <a class={LINK} href={href}>
                  {label}
                  <Glyph name="↗" class={GLYPH_GAP} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </GridFrame>

    <p class="mt-16 label-mono text-ink-muted">
      © {BUILD_YEAR} {legalName} {labels.rights}
    </p>
  </div>
</footer>
