---
/**
 * The page's closing band: a full-bleed top rule, then spaced columns (no boxed cells) and, below
 * them, the SMPTE bars strip over the legal row.
 * Columns: (1) the brand line: logo, then legal name, address and the contacts in one `<address>`;
 * (2) the indexed footer nav; (3) the applications, in the header menu's order and cap; (4) socials.
 * Applications and Follow render only when they have entries, so the grid has two to four tracks.
 * Every column's first row is the same `min-h-11` box, so the first rows share one line; one
 * running `[NN]` sequence runs over the column labels (the nav rows, then Applications and Follow).
 * The Contact label belongs to column 1, not to the column labels, so it carries no index.
 * Contacts keep their own `mailto:` / `tel:` / `https:` hrefs; outbound links get ↗.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ComponentProps } from 'astro/types';
import type { Locale } from '../../lib/i18n.ts';
import { EXTERNAL_PREFIX } from '../../lib/link-schemes.ts';
import BarsStrip from '../ui/BarsStrip.astro';
import GridFrame from '../ui/GridFrame.astro';
import Label from '../ui/Label.astro';
import FooterLinkColumn from './FooterLinkColumn.astro';

type Link = { label: string; href: string };
type Columns = NonNullable<ComponentProps<typeof GridFrame>['columns']>;

interface Props {
  homeHref: string;
  logo: ImageMetadata;
  logoAlt: string;
  legalName: string;
  address?: string | undefined;
  /** Footer nav, hrefs already localized by BaseLayout. */
  links: readonly Link[];
  contacts: readonly { value: string; href: string }[];
  /**
   * Applications as the header menu lists them, hrefs localized by BaseLayout; `lang` is set on
   * an EN fallback entry shown on another locale's page (WCAG 3.1.2).
   */
  applications: readonly (Link & { lang?: Locale | undefined })[];
  socials: readonly Link[];
  labels: { nav: string; contact: string; applications: string; social: string; rights: string };
}

/** Brand and nav always; Applications and Follow each add a track when they have entries. */
const COLUMNS_FIXED = 2;
/** `[NN]` indexes count from 1. */
const FIRST_INDEX = 1;
/** Stamped at build time; the site rebuilds on every content change. */
const BUILD_YEAR = new Date().getFullYear();
/** Label ids that name the link lists; the footer renders once per page. */
const CONTACT_ID = 'footer-contact';
const APPLICATIONS_ID = 'footer-applications';
const SOCIAL_ID = 'footer-social';

const {
  homeHref,
  logo,
  logoAlt,
  legalName,
  address,
  links,
  contacts,
  applications,
  socials,
  labels,
} = Astro.props;

const hasApplications = applications.length > 0;
const hasSocials = socials.length > 0;
/** Two to four by construction, the range GridFrame takes. */
const columns = (COLUMNS_FIXED + Number(hasApplications) + Number(hasSocials)) as Columns;
/** The nav rows take the first indexes; the Applications and Follow labels continue the run. */
const applicationsIndex = links.length + FIRST_INDEX;
const socialIndex = applicationsIndex + Number(hasApplications);
/** Settings often repeat the street address as a linked contact; print it once, as the link. */
const showAddress = address !== undefined && !contacts.some(({ value }) => value === address);
const contactLinks = contacts.map(({ value, href }) => ({
  label: value,
  href,
  external: href.startsWith(EXTERNAL_PREFIX),
}));
const socialLinks = socials.map((link) => ({ ...link, external: true }));
---
<footer class="mt-24 border-t border-line">
  <div class="mx-auto max-w-page px-4 pt-12 pb-8 md:px-8">
    <GridFrame columns={columns}>
      <div class="flex flex-col gap-6">
        <a href={homeHref} class="flex min-h-11 items-center self-start">
          <Image src={logo} alt={logoAlt} class="h-6 w-auto" />
        </a>
        <address class="flex flex-col gap-4 not-italic">
          <p class="text-ink-muted">
            <span class="block text-ink">{legalName}</span>
            {showAddress && <span class="block">{address}</span>}
          </p>
          <FooterLinkColumn id={CONTACT_ID} label={labels.contact} items={contactLinks} />
        </address>
      </div>

      <nav aria-label={labels.nav}>
        <ul class="flex flex-col">
          {
            links.map(({ label, href }, index) => (
              <li>
                <a class="flex min-h-11 items-center hover:[&_span]:text-ink" href={href}>
                  <Label as="span" text={label} index={index + FIRST_INDEX} />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {
        hasApplications && (
          <FooterLinkColumn
            id={APPLICATIONS_ID}
            label={labels.applications}
            index={applicationsIndex}
            items={applications}
          />
        )
      }

      {
        hasSocials && (
          <FooterLinkColumn
            id={SOCIAL_ID}
            label={labels.social}
            index={socialIndex}
            items={socialLinks}
          />
        )
      }
    </GridFrame>

    <div class="mt-16 flex flex-col gap-4">
      <BarsStrip />
      <p class="label text-ink-muted">
        © {BUILD_YEAR} {legalName} {labels.rights}
      </p>
    </div>
  </div>
</footer>
