---
/**
 * Broadcast status band under the header: `■ LIVE   TC 00:00:00:00   CH 01   ■ PGM ■ PVW ··· 1080i50`.
 * A `surface` band, no rules: segments are split by spacing only (the header's bottom rule above
 * is the one line). PGM is the on-air tally (accent lamp), PVW the standby one (muted lamp).
 * Pure decoration, so the whole band is hidden from assistive tech. Channel, then PGM/PVW and the
 * format drop out on narrow screens so the row never wraps or scrolls. The format keeps its case
 * (`1080i50`: the `i` means interlaced).
 */
import Tally from '../ui/Tally.astro';
import Timecode from '../ui/Timecode.astro';

interface Props {
  live: string;
  timecode: string;
  channel: string;
  program: string;
  preview: string;
  format: string;
}

const { live, timecode, channel, program, preview, format } = Astro.props;
---
<div class="bg-surface" aria-hidden="true">
  <div
    class="mx-auto flex h-10 max-w-page items-center gap-6 overflow-x-clip px-4 label-mono md:gap-8 md:px-8"
  >
    <Tally text={live} />
    <Timecode prefix={timecode} />
    <span class="hidden text-ink-muted sm:inline">{channel}</span>
    <span class="hidden items-center gap-4 md:flex">
      <Tally text={program} />
      <Tally text={preview} tone="muted" />
    </span>
    <span class="ms-auto hidden text-ink-muted normal-case md:inline">{format}</span>
  </div>
</div>
