---
/**
 * Sticky top bar: logo (home link, named by `logoAlt`; the logo is a wordmark), the inline nav
 * with its mega panels from `lg` (DesktopNav), language toggle, the quote key from `md` and the
 * MobileNav button below `lg`. The quote key is never hidden: below `md` it lives in the menu
 * sheet. Both navs take the same resolved items (`resolveNavItems` in BaseLayout), so they share
 * one highlight rule.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Locale } from '../../lib/i18n.ts';
import type { NavItem } from '../../lib/nav-items.ts';
import Button from '../ui/Button.astro';
import DesktopNav from './DesktopNav.astro';
import LanguageToggle from './LanguageToggle.astro';
import MobileNav from './MobileNav.astro';

type Link = { label: string; href: string };

interface Props {
  locale: Locale;
  neutralPath: string;
  availableLocales: readonly Locale[];
  homeHref: string;
  logo: ImageMetadata;
  logoAlt: string;
  /** Header nav: hrefs localized and states resolved by BaseLayout. */
  items: readonly NavItem[];
  quote: Link;
  labels: {
    nav: string;
    submenu: string;
    overview: string;
    language: string;
    menuOpen: string;
    menuClose: string;
  };
}

const { locale, neutralPath, availableLocales, homeHref, logo, logoAlt, items, quote, labels } =
  Astro.props;
---
<header class="sticky top-0 z-(--z-header) border-b border-line bg-canvas">
  <div class="mx-auto flex h-(--header-bar) max-w-page items-center gap-4 px-4 md:gap-6 md:px-8">
    <a href={homeHref} class="me-auto flex min-h-11 shrink-0 items-center">
      <Image src={logo} alt={logoAlt} class="h-7 w-auto" loading="eager" />
    </a>

    <DesktopNav items={items} navLabel={labels.nav} submenuLabel={labels.submenu} />

    <LanguageToggle
      locale={locale}
      neutralPath={neutralPath}
      availableLocales={availableLocales}
      label={labels.language}
    />

    <div class="hidden whitespace-nowrap md:block">
      <Button href={quote.href} size="sm" caption="body">{quote.label}</Button>
    </div>

    <MobileNav
      items={items}
      quote={quote}
      navLabel={labels.nav}
      openLabel={labels.menuOpen}
      closeLabel={labels.menuClose}
      overviewLabel={labels.overview}
    />
  </div>
</header>
