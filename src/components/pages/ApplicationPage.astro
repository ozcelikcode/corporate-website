---
/**
 * One application: a header band (category label, the page's h1, status tally, summary, links
 * and brochure on the left; the duotone cover in the title-safe frame on the right), then its
 * own sections with no `pageTitle` (this header already holds the h1). The h1 is a plain display
 * heading: lower thirds are for section headings and card titles. The cover uses the same
 * duotone as the app-grid tiles (greyscale + contrast, multiplied by an accent layer).
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { availableLocales, getUiDictionary, listApplications } from '../../lib/content.ts';
import { applicationPath, type Locale, t, type UiKey } from '../../lib/i18n.ts';
import SectionRenderer from '../sections/SectionRenderer.astro';
import Button from '../ui/Button.astro';
import GridFrame from '../ui/GridFrame.astro';
import Heading from '../ui/Heading.astro';
import Label from '../ui/Label.astro';
import { LEDE_CLASS } from '../ui/lede-class.ts';
import Tally from '../ui/Tally.astro';
import TitleSafe from '../ui/TitleSafe.astro';

interface Props {
  locale: Locale;
  slug: string;
}

const COVER_FORMATS = ['avif', 'webp'] as const;
/** The cover fills about half the container from lg and the full width below. */
const COVER_WIDTHS = [640, 960, 1280];
const COVER_SIZES = '(min-width: 64rem) 45vw, 100vw';
const CONTAINER = 'mx-auto max-w-page px-4 md:px-8';
const HEADER_BAND = 'pt-12 pb-16 md:pt-16 md:pb-24';

const { locale, slug } = Astro.props;

const [applications, locales, dict] = await Promise.all([
  listApplications(locale),
  availableLocales('applications', slug),
  getUiDictionary(),
]);
const application = applications.find((candidate) => candidate.slug === slug);
if (application === undefined) throw new Error(`Missing application "${slug}"`);
const { data } = application;
const ui = (key: UiKey) => t(dict, locale, key);
const hasActions = data.brochure !== undefined || (data.links?.length ?? 0) > 0;
---
<BaseLayout
  locale={locale}
  contentLocale={application.locale}
  neutralPath={applicationPath(slug)}
  title={data.name}
  description={data.tagline}
  availableLocales={locales}
>
  <div class={HEADER_BAND}>
    <div class={CONTAINER}>
      <GridFrame columns={12}>
        <div class="flex flex-col items-start gap-8 lg:col-span-6 lg:self-center">
          <Label text={data.category} />
          <Heading level={1} text={data.name} />
          <Tally text={data.status} />
          <p class={LEDE_CLASS}>{data.summary}</p>
          {
            hasActions && (
              <div class="flex flex-wrap gap-4">
                {data.brochure !== undefined && (
                  <Button href={data.brochure} intent="secondary">
                    {ui('appBrochure')}
                  </Button>
                )}
                {(data.links ?? []).map((link) => (
                  <Button href={link.href} intent="secondary">
                    {link.label}
                  </Button>
                ))}
              </div>
            )
          }
        </div>
        <div class="min-w-0 lg:col-span-6 lg:self-center">
          <TitleSafe>
            <div class="relative isolate bg-canvas">
              <Picture
                src={data.cover}
                alt={data.coverAlt}
                formats={[...COVER_FORMATS]}
                widths={COVER_WIDTHS}
                sizes={COVER_SIZES}
                loading="eager"
                class="block h-auto w-full grayscale contrast-150"
              />
              <span class="absolute inset-0 bg-accent mix-blend-multiply" aria-hidden="true" />
            </div>
          </TitleSafe>
        </div>
      </GridFrame>
    </div>
  </div>
  {
    data.sections.length > 0 && (
      <div class="border-t border-line">
        <SectionRenderer sections={data.sections} locale={locale} />
      </div>
    )
  }
</BaseLayout>
